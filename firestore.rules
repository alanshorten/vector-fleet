rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Membership document helpers (Phase 3 Session 6 — 3C / M-01) ---
    // Custom claims (request.auth.token.role/tenantId) are baked into the
    // ID token at mint time and stay valid for up to an hour by default,
    // even after an admin changes or revokes access. Server endpoints now
    // close most of that gap with verifyIdToken(token, true) (Layer 1 —
    // see bootstrap-admin.js/set-role.js/invite-user.js/remove-user.js/
    // share/create.js/share/revoke.js/extract.js), but Firestore rules have
    // no equivalent check against the token itself. Consulting the
    // tenantMembers document instead gives WRITE rules an instant,
    // rules-visible source of truth — updated the moment an admin changes a
    // role or removes a user, no token refresh or expiry window involved.
    // READS still use the fast token-claim check only, unchanged from
    // before this session — an extra document read on every read would be
    // needless overhead for data that isn't itself a privilege-escalation
    // risk, and the roadmap's own Layer 2 design note says as much.
    function memberDoc(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/tenantMembers/$(request.auth.uid));
    }
    function isActiveMember(tenantId) {
      return request.auth != null
        && request.auth.token.tenantId == tenantId
        && memberDoc(tenantId).data.status == 'active';
    }
    function memberHasRole(tenantId, roles) {
      return isActiveMember(tenantId) && memberDoc(tenantId).data.role in roles;
    }
    // tenantMembers itself (Decision 2). Written exclusively by admin
    // server endpoints via the Admin SDK, which bypasses these rules
    // entirely — bootstrap-admin.js, set-role.js, invite-user.js,
    // remove-user.js. No client read/write access is needed or granted;
    // the role/status/email fields here are enforcement data consulted by
    // the helpers above and by other collections' write rules, not
    // something the app's UI reads or displays today.
    match /tenants/{tenantId}/tenantMembers/{uid} {
      allow read, write: if false;
    }
    // Tenant document itself (Build Group A, tenant onboarding —
    // claude_security-review-20260818-handoff.md). Written exclusively by
    // api/create-tenant.js via the Admin SDK, which bypasses these rules.
    // Read is gated on the platform-level superAdmin claim — separate from
    // and above the tenant-scoped role model — since this is what the
    // /platform tenant-list screen queries. No tenant-scoped role (not even
    // admin) can read another tenant's doc; only a super-admin manages the
    // list of tenants.
    match /tenants/{tenantId} {
      allow read: if request.auth != null && request.auth.token.superAdmin == true;
      allow write: if false;
    }
    // approvedSenders (Build Group A) — the email-ingest sender allowlist
    // consulted by api/email-ingest.js's sender-verification step. Seeded at
    // tenant-creation time by api/create-tenant.js (Admin SDK, bypasses
    // these rules); this rule governs ongoing management once a platform
    // sender-management UI exists. Admin-only, same posture as `settings`
    // (Decision 4) — editors don't manage security-relevant allowlists.
    match /tenants/{tenantId}/approvedSenders/{docId} {
      allow read, write: if memberHasRole(tenantId, ['admin']);
    }
    // Tenant-rooted assets (security-remediation-roadmap.md Phase 3, Session 1).
    // The `assets` collection now lives at /tenants/{tenantId}/assets/{assetId}
    // for anyone with the new tenantId custom claim (see bootstrap-admin.js/
    // set-role.js/invite-user.js). request.auth.token.tenantId == tenantId
    // means a user can only reach their OWN tenant's asset subtree — someone
    // whose token has no tenantId claim yet (pre-migration reload) is denied
    // here rather than silently falling through, since a null/undefined
    // claim can never equal a real path segment.
    //
    // The old flat /assets/{assetId} match further down was closed to deny
    // 2026-08-17 (second-reassessment-followup-scoping-handoff.md item 2) —
    // db.js has been on this tenant-rooted path since Phase 3 Session 1 and
    // has been stable for weeks, so it was safe to close the rollback path.
    // H-01 fix: enforce type on the small set of top-level asset scalar
    // fields that feed straight into fmtHHMM()/toLocaleString() in the
    // tech-spec renderer (public/calculations/techSpecBuilder.js) — msn
    // must stay a string, currentFH/currentFC (when present at the top
    // level) must stay numbers. Full type enforcement on the nested
    // engines[]/llps[]/shopVisits[] arrays (where most of H-01's affected
    // fields actually live — currentFH, currentFC, fh, fc, tsnAtRemoval,
    // csnAtRemoval, weights.*) is not practical in Firestore Rules, which
    // has no way to iterate and validate arbitrary-length array-of-map
    // elements. That gap is closed instead on the read/render side: every
    // formatter that touches those nested numeric fields (fmtHHMM, fmtNum)
    // now strictly coerces to Number and renders "—" for anything that
    // isn't a finite number, so a non-numeric value stored in those fields
    // can no longer reach the generated HTML as attacker-controlled markup
    // regardless of what's sitting in Firestore. A Cloud Function-based
    // full-document validator remains a reasonable follow-up for
    // defense-in-depth but isn't required to close H-01 itself.
    function assetScalarFieldsValid() {
      let d = request.resource.data;
      return (!('msn' in d) || d.msn is string)
          && (!('currentFH' in d) || d.currentFH is number)
          && (!('currentFC' in d) || d.currentFC is number);
    }
    match /tenants/{tenantId}/assets/{assetId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      // Phase 3 Session 6 (3C / M-01): write now consults the tenantMembers
      // doc (memberHasRole above) instead of the token claim directly — see
      // the helper functions' comment for why.
      allow write: if memberHasRole(tenantId, ['admin', 'editor', 'dataEntry'])
                   && assetScalarFieldsValid();
    }
    // Tenant-rooted leases/reserves (Phase 3, Session 2). Same shape and
    // same role gate as the flat rules below, just under the tenant path —
    // see the assets rule above for the reasoning on tenantId checks.
    match /tenants/{tenantId}/leases/{leaseId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      allow write: if memberHasRole(tenantId, ['admin', 'editor', 'dataEntry']);
    }
    match /tenants/{tenantId}/reserves/{reserveId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      allow write: if memberHasRole(tenantId, ['admin', 'editor', 'dataEntry']);
    }
    // Tenant-rooted scheduledEvents/seasonalityProfile (Phase 3, Session 3).
    // Same shape as leases/reserves above but admin/editor ONLY (no
    // dataEntry) — matches the role gate on the flat rules below, since
    // these are Calendar-tab-only, financial-projection-shaping edits that
    // Data Entry never sees in the nav.
    match /tenants/{tenantId}/scheduledEvents/{eventId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      allow write: if memberHasRole(tenantId, ['admin', 'editor']);
    }
    match /tenants/{tenantId}/seasonalityProfile/{assetId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      allow write: if memberHasRole(tenantId, ['admin', 'editor']);
    }
    // Tenant-rooted shopVisitProjections (second-reassessment-followup-
    // scoping-handoff.md item 3, 2026-08-17). This collection was never
    // tenant-rooted during Phase 3 — a straightforward migration miss, not
    // a deliberate choice. Same append-only shape as the flat rule below:
    // create open to any signed-in tenant member (a Viewer can trigger a
    // monthly snapshot just by having the Financials tab open), update and
    // delete blocked outright — every recompute writes a new doc rather
    // than touching a prior one.
    match /tenants/{tenantId}/shopVisitProjections/{docId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      // Item 9 (18 Aug review): create was still using the plain token-claim
      // check instead of isActiveMember(tenantId), inconsistent with every
      // other tenant-rooted collection — a removed member's still-valid
      // token could write here until it expired. Aligned with the pattern
      // used everywhere else in this file.
      allow create: if isActiveMember(tenantId);
      allow update, delete: if false;
    }
    // Tenant-rooted knowledgeBase (second-reassessment-followup-scoping-
    // handoff.md item 3, 2026-08-17 — Alan confirmed: tenant-root it rather
    // than keep a shared global default). Same admin/editor-only write gate
    // as the flat rule below — house-view forecasting assumption data, not
    // raw per-asset input. Doc id continues to be `${companyId || 'default'}`
    // under the tenant path — companyId stays the pre-existing, always-null
    // legacy field, unrelated to tenantId, same pattern already used for
    // leases/reserves/etc.
    match /tenants/{tenantId}/knowledgeBase/{companyId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      allow write: if memberHasRole(tenantId, ['admin', 'editor']);
      match /llpCatalogue/{partNumber} {
        allow read: if request.auth != null
                    && request.auth.token.tenantId == tenantId;
        allow write: if memberHasRole(tenantId, ['admin', 'editor']);
      }
    }
    // Tenant-rooted completedEvents (second-reassessment-followup-scoping-
    // handoff.md item 3, 2026-08-17). FIXES A LIVE BUG: this collection
    // never had ANY rule anywhere in this file — not flat, not tenant-
    // rooted — despite db.js's saveCompletedEvent/deleteCompletedEvent
    // comments assuming an admin/editor gate already existed here "same as
    // scheduledEvents/seasonalityProfile". Firestore's implicit default-
    // deny silently blocked every client read and write as a result;
    // confirmed broken in production by Alan 2026-08-17. This is the fix —
    // matches the role gate db.js's own comments already assumed was live.
    match /tenants/{tenantId}/completedEvents/{eventId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      allow write: if memberHasRole(tenantId, ['admin', 'editor']);
    }
    // Financial reserve/lease data — writes restricted to admin/editor/
    // dataEntry roles. "role" is the Firebase Auth custom claim already
    // set by /api/bootstrap-admin and /api/set-role, and already read
    // client-side via getIdTokenResult().claims.role. dataEntry is
    // included here (not on scheduledEvents/seasonalityProfile below)
    // because lease/reserve pot entry is explicitly part of the Data
    // Entry role's job (raw inputs), per VECTORIQ_ROADMAP.md's four-role
    // model — Viewer is deliberately excluded everywhere, since Viewer
    // edits nothing permanent. Reads stay open to any signed-in user for
    // now, matching every other collection below, pending the fuller
    // Viewer/Editor/Admin read-scoping pass in Section 7.
    //
    // CLOSED (2026-08-17, second-reassessment-followup-scoping-handoff.md
    // item 2): the tenant-rooted path above has been live and stable since
    // mid-August. Documents remain in Firestore as a rollback copy — only
    // access is denied, nothing was deleted.
    match /leases/{leaseId} {
      allow read, write: if false;
    }
    match /reserves/{reserveId} {
      allow read, write: if false;
    }
    // Core asset records — same role gate as above. Specs, engines, LLP
    // sheets, and avionics listings are all written onto the asset doc
    // via the Quick Import / Upload-tab extraction flows, which are part
    // of Data Entry's raw-input job just as much as lease/reserve entry.
    // The app's own UI still keeps manual field-editing in the Details
    // tabs admin/editor-only (isAdmin) — this rule only governs the
    // collection-level write, not which in-app flow produced it.
    //
    // CLOSED (2026-08-17, second-reassessment-followup-scoping-handoff.md
    // item 2): this was the original C-01 cross-tenant bypass path — any
    // signed-in user with a write role could reach any tenant's asset data
    // through this flat path regardless of the tenant-rooted rule above.
    // Now denied outright. Documents remain in Firestore as a rollback copy.
    match /assets/{assetId} {
      allow read, write: if false;
    }
    // Maintenance calendar overrides — admin/editor ONLY, deliberately
    // NOT dataEntry. These feed the Calendar tab, which Data Entry never
    // sees in the nav (VECTORIQ_ROADMAP.md §7a) — date, duration,
    // downtime, and concurrency overrides stay financial-projection-
    // shaping edits reserved for Admin/Editor. Doc id is the
    // assetId_code_dueCycle identity key from Brain 6's own join.
    //
    // CLOSED (2026-08-17, second-reassessment-followup-scoping-handoff.md
    // item 2). Documents remain in Firestore as a rollback copy.
    match /scheduledEvents/{eventId} {
      allow read, write: if false;
    }
    // One reviewed seasonality profile per asset (doc id = assetId),
    // same role gate as scheduledEvents — Brain 6 reads this for
    // placement suggestions. Also Calendar-tab-only, not dataEntry.
    //
    // CLOSED (2026-08-17, second-reassessment-followup-scoping-handoff.md
    // item 2). Documents remain in Firestore as a rollback copy.
    match /seasonalityProfile/{assetId} {
      allow read, write: if false;
    }
    // Knowledge Base — house-view forecasting defaults (checkCostBands,
    // enPrBandsByFamily, llpEscalationPctByFamily, outflowEscalationPct)
    // plus the LLP Catalogue subcollection. Admin/Editor ONLY, deliberately
    // NOT dataEntry (knowledge-base-scoping-handoff.md §4: "Only
    // Admin/Editor roles can edit") — this is house-view assumption data,
    // a different category from raw per-asset input. Reads open to any
    // signed-in user, since Fly-Forward's read-only Assumptions panel is
    // visible to Viewer too. Doc id is `${companyId}` per the scoping
    // doc's shape; a literal "default" id is used pre-multi-tenancy (see
    // db.js), same null-companyId-for-now pattern as every other
    // collection here.
    //
    // CLOSED (2026-08-17, second-reassessment-followup-scoping-handoff.md
    // item 2 — migrated and confirmed via migrate-3-collections-to-tenant.js
    // the same day it was tenant-rooted). Documents remain in Firestore as
    // a rollback copy.
    match /knowledgeBase/{companyId} {
      allow read, write: if false;
      match /llpCatalogue/{partNumber} {
        allow read, write: if false;
      }
    }
    // Audit trail — appendable by any signed-in user (logAudit() fires
    // alongside ordinary asset saves, not just admin actions), but
    // genuinely immutable once written. There is no legitimate app path
    // that ever updates or deletes a past entry — allowing it anyway
    // would mean the log could be silently altered or erased after the
    // fact, defeating its purpose.
    //
    // Phase 3 Session 7 (3D / M-03, security-remediation-roadmap.md):
    // previously a signed-in user could create a doc here with ANY
    // userId/userEmail/timestamp — impersonating another user or
    // backdating an entry, since only request.auth != null was checked.
    // Now every field is bound to the caller's own verified identity:
    // userId/userEmail must match the caller's own auth token (can't log
    // an action as someone else), timestamp must equal request.time
    // (db.js now writes serverTimestamp() instead of a client-supplied ISO
    // string, so this actually matches), and only the exact field set
    // logAudit() ever writes is permitted — no extra fields smuggled in.
    // `action` is free-text (see FlyForward.jsx's completed-event delete
    // log, which composes a dynamic string) rather than a fixed enum — a
    // strict allowlist isn't compatible with how this field is actually
    // used across the app, so this constrains it to a non-empty string
    // under a sane length cap instead, which closes the actual abuse case
    // (arbitrary/oversized payload injection) without breaking legitimate
    // descriptive messages.
    // Item 8 (18 Aug review): auditLog was never tenant-rooted at all — any
    // signed-in user from any tenant could read every tenant's audit trail
    // via the flat rule below (writes were already identity-bound, Phase 3
    // Session 7, but the collection itself sat at a flat, cross-tenant-
    // readable path). Tenant-rooted here, carrying over the exact same
    // identity/timestamp/field-set write binding from the flat rule
    // (see the comment block above the old match, kept for context on WHY
    // those checks exist). Read narrowed to admin only — the flat rule's
    // "any signed-in user" read was itself part of the exposure, not just
    // the missing tenant scoping, so this doesn't just carry that forward.
    match /tenants/{tenantId}/auditLog/{entryId} {
      allow read: if memberHasRole(tenantId, ['admin']);
      allow create: if isActiveMember(tenantId)
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.userEmail == request.auth.token.email
                     && request.resource.data.timestamp == request.time
                     && request.resource.data.action is string
                     && request.resource.data.action.size() > 0
                     // Raised from 300 to 1000 (audit log scope expansion,
                     // Session B, 19 Aug 2026) — level-2 (before/after) diff
                     // logging on financial edits (e.g. reserve pot changes
                     // with several changed fields) can exceed 300 chars
                     // easily; truncating would lose exactly the detail this
                     // log exists to capture. No real cost to Firestore at
                     // this size.
                     && request.resource.data.action.size() <= 1000
                     && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'timestamp', 'assetId', 'assetMSN', 'action']);
      allow update, delete: if false;
    }
    // Flat auditLog — CLOSED (item 8, 18 Aug review), same rollback-copy
    // pattern as the other flat collections denied above: documents remain
    // in Firestore (migrated via scripts/migrate-auditlog-to-tenant.js, not
    // deleted), only access is denied.
    match /auditLog/{entryId} { allow read, write: if false; }
    // Shop visit cost projections — append-only, same immutable-log
    // pattern as auditLog. Create is deliberately open to any signed-in
    // user, including Viewer, since a Viewer can trigger the monthly
    // snapshot just by having the Financials tab open. Update/delete are
    // blocked outright — every recompute writes a new doc rather than
    // touching a prior one.
    //
    // CLOSED (2026-08-17, second-reassessment-followup-scoping-handoff.md
    // item 2 — migrated and confirmed via migrate-3-collections-to-tenant.js
    // the same day it was tenant-rooted). Documents remain in Firestore as
    // a rollback copy.
    match /shopVisitProjections/{docId} {
      allow read, write: if false;
    }
    // completedEvents (flat path) — deliberately has NO rule here. This is
    // not an oversight left in place: it's the documentation of a bug found
    // and fixed 2026-08-17 (see the tenant-rooted completedEvents rule
    // above). This collection never had a working rule at any path, flat
    // or tenant-rooted, despite db.js's comments assuming one existed —
    // Firestore's default-deny silently blocked every client read/write.
    // No flat-path version ever worked, so unlike the other DEPRECATED
    // collections above, there's no "rollback copy" to preserve here — the
    // fix goes straight to the tenant-rooted path with no transitional
    // flat rule at all. Left as an explicit `if false` below (rather than
    // just omitting the match block) so a future reader sees this was a
    // deliberate, documented decision, not an accidental gap re-emerging.
    match /completedEvents/{eventId} {
      allow read, write: if false;
    }
    // Tenant-rooted utilisation/pendingReports (Phase 3, Session 4). Same
    // tenantId-scoped shape as the earlier tenant-rooted rules above, no
    // role restriction (any active tenant member can write) — matches the
    // permissive any-signed-in-user pattern on the flat rules below, just
    // narrowed to the caller's own tenant. Write now uses isActiveMember
    // (Phase 3 Session 6 — 3C / M-01) so a disabled/removed user's writes
    // stop instantly rather than waiting on token expiry; read is unchanged.
    match /tenants/{tenantId}/utilisation/{docId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      allow write: if isActiveMember(tenantId);
    }
    match /tenants/{tenantId}/pendingReports/{docId} {
      allow read: if request.auth != null
                  && request.auth.token.tenantId == tenantId;
      allow write: if isActiveMember(tenantId);
    }
    // shareTokens (Phase 3, Session 5 — 3B / H-02). Reads stay open to any
    // signed-in user in the tenant (the ShareModal UI lists existing tokens
    // for an asset), but ALL writes are denied outright — creation and
    // revocation now happen exclusively through api/share/create.js and
    // api/share/revoke.js (Admin SDK, bypasses these rules entirely), which
    // enforce admin/editor role and asset-ownership checks server-side
    // before writing anything. This closes H-02: previously any signed-in
    // user (including Viewer/DataEntry) could create a share link for any
    // asset by writing directly to this collection from the browser.
    // Item 4 (18 Aug review): reads were open to any signed-in tenant user,
    // including Data Entry — shareTokens documents hold plaintext bearer
    // tokens, and Data Entry has no legitimate reason to see the Share
    // modal's token list. Narrowed to admin/editor/viewer.
    // M-03 fix: shareTokens documents ARE the plaintext bearer token (the
    // doc ID is the token used in the public share URL) — a rules-based
    // read check can only gate on the caller's ROLE, not on whether they
    // created a given token or on live (non-token-cached) membership
    // status. That meant any admin/editor/viewer with a still-valid ID
    // token could read and copy every token in the collection, including
    // ones created by someone else, and kept being able to for as long as
    // their cached token lasted even after being downgraded/disabled
    // elsewhere. Reads are now denied outright, same as writes already
    // were — api/share/list.js (Admin SDK, re-checks live tenantMembers
    // status on every call) is the only read path left.
    match /tenants/{tenantId}/shareTokens/{token} {
      allow read, write: if false;
    }
    // Everything else — unchanged from before: any signed-in Firebase
    // Auth user. Written as explicit per-collection matches rather than
    // a single {document=**} wildcard, because Firestore rules are
    // additive across matching blocks — a broad catch-all below the
    // rules above would otherwise still independently grant broader
    // access to those same documents, silently undoing the restrictions
    // just added.
    //
    // CLOSED (2026-08-17, second-reassessment-followup-scoping-handoff.md
    // item 2): utilisation, shareTokens, and pendingReports were the last
    // three of the original eight flat rollback collections still open.
    // Documents remain in Firestore as a rollback copy — only access is
    // denied, nothing was deleted.
    match /utilisation/{docId} { allow read, write: if false; }
    match /shareTokens/{token} { allow read, write: if false; }
    match /pendingReports/{docId} { allow read, write: if false; }
    // Settings — Decision 4 (security-remediation-roadmap.md Phase 2A):
    // writes restricted to admin/editor only, belt-and-braces alongside the
    // output-escaping fix already shipped in Phase 2A (techSpecBuilder.js's
    // escapeHtml()). Viewer and DataEntry excluded — this collection holds
    // things like the tech-spec disclaimer text and branding toggle, which
    // feed directly into the same HTML templates Phase 2A hardened; keeping
    // write access no broader than the components that consume it is the
    // point of "belt and braces" here.
    //
    // M-01 fix (19 Aug 2026 security review): the "not tenant-rooted, out
    // of scope for this session" note that used to sit here is no longer
    // true — settings moved from the flat, cross-tenant /settings/{key}
    // path above to a tenant-rooted subtree, gated the same way as the
    // other tenant-rooted collections (memberHasRole against the live
    // tenantMembers doc, not just the token's role claim — see the helper
    // functions' comment at the top of this file). Read is any active
    // member of the tenant (branding/disclaimer settings aren't sensitive
    // to read within a tenant, same posture the old rule had); write stays
    // admin/editor, matching the flat rule's original intent.
    match /tenants/{tenantId}/settings/{key} {
      allow read: if isActiveMember(tenantId);
      allow write: if memberHasRole(tenantId, ['admin', 'editor']);
    }
    // Old flat /settings/{key} path — deny-by-default now that the app has
    // moved to the tenant-rooted path above. Left explicit (rather than
    // just letting it fall through to Firestore's default deny) so it's
    // clear this was a deliberate close, not an oversight, the same
    // pattern already used for the old flat /assets/{assetId} path.
    match /settings/{key} {
      allow read, write: if false;
    }
  }
}